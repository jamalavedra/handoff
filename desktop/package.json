{
  "name": "handoff-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Handoff desktop app — a thin Electron shell around a hosted workspace",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --mac --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.handoff.app",
    "productName": "Handoff",
    "files": ["main.js", "preload.js", "prompt.html"],
    "directories": { "output": "release" },
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": ["zip"], "category": "public.app-category.productivity" },
    "linux": { "target": ["AppImage"], "category": "Utility" }
  }
}
