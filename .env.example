# Copy to .env and fill in. See README.md for every option.
POSTGRES_PASSWORD=change-me

# Public address. Workspaces live at <slug>.<host>, e.g. https://acme.tasks.example.com
HANDOFF_BASE_URL=https://tasks.example.com
# Required: 32+ random characters, kept forever and the same on every server. Encrypts stored
# credentials and signs links; changing it breaks them. Generate: openssl rand -hex 32
HANDOFF_SECRET=
HANDOFF_ACME_EMAIL=ops@example.com

# Self-host for one company: serve only this workspace on HANDOFF_BASE_URL itself.
# HANDOFF_SINGLE_ORG=acme
# HANDOFF_SINGLE_ORG_NAME=Acme
# HANDOFF_ADMIN_EMAIL=you@acme.com

# Hosted mode: let anyone create a workspace on the apex (default on when not single-org).
# HANDOFF_ALLOW_SIGNUP=false

# Email for sign-in links: smtp://user:pass@smtp.example.com:587
HANDOFF_SMTP_URL=
HANDOFF_MAIL_FROM=Handoff <no-reply@example.com>

# Optional Google sign-in. Redirect URI: <HANDOFF_BASE_URL>/auth/google/callback
HANDOFF_GOOGLE_CLIENT_ID=
HANDOFF_GOOGLE_CLIENT_SECRET=

# Optional Settings → Apps: people connect their own Gmail, Google Calendar, Drive, Slack, GitHub,
# Notion and Linear through Composio, and their assistant can read them. A Composio project API key
# from https://platform.composio.dev
HANDOFF_COMPOSIO_API_KEY=
# X needs an auth config made with your own X developer app in Composio (ac_…).
HANDOFF_COMPOSIO_X_AUTH_CONFIG=
